# LLM (required for a real model; the example profile uses spec = "test")
OPENAI_API_KEY=
# For anthropic: specs
# ANTHROPIC_API_KEY=
# Optional: send openai: specs to an OpenAI-compatible server. Unset uses OpenAI.
# OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Required on the first start of a data root: password of the "admin" user
# (8+ characters). Ignored once <data-root>/users.json exists.
HARNESS_ADMIN_PASSWORD=
# Optional, first start only: admin's API key. Unset = generated and printed once
# (or kept from a 0.1 <data-root>/api_key file).
# HARNESS_ADMIN_API_KEY=

# Optional: live traces
# LOGFIRE_TOKEN=

# HARNESS_UI_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
# HARNESS_DATA_ROOT=
# HARNESS_PROFILE=
