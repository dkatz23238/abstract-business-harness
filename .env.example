# LLM (required for a real model; the example profile uses spec = "test")
OPENAI_API_KEY=

# Optional: protect the HTTP UI (Bearer or ?token=)
# HARNESS_UI_TOKEN=

# Optional: enable /admin (profile file + env writes). Unset = admin disabled.
# HARNESS_ADMIN_TOKEN=

# Optional: live traces
# LOGFIRE_TOKEN=

# HARNESS_UI_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
# HARNESS_DATA_ROOT=
# HARNESS_PROFILE=
